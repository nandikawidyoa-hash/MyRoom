rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/couples/$(coupleId)) &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);

      match /privateNotes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /privateDiary/{entryId} {
        allow read, write: if isOwner(userId);
      }

      match /privateTasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      match /privateCollection/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /invitationCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.isUsed == false;
      allow update: if isSignedIn()
        && resource.data.isUsed == false
        && request.resource.data.isUsed == true
        && request.resource.data.usedByUid == request.auth.uid
        && request.auth.uid != resource.data.creatorUid;
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 2;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds.size() <= 2;

      match /sharedNotes/{noteId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /sharedDiary/{entryId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /tasks/{taskId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /events/{eventId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /bucketList/{itemId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /memories/{memoryId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /letters/{letterId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /timeCapsules/{capsuleId} {
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.authorUid == request.auth.uid;
        allow read: if isCoupleMember(coupleId) && (
          resource.data.authorUid == request.auth.uid ||
          request.time.toMillis() >= resource.data.unlockAtServerMillis
        );
        allow update, delete: if isCoupleMember(coupleId)
          && resource.data.authorUid == request.auth.uid;
      }

      match /surprises/{surpriseId} {
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.creatorUid == request.auth.uid;
        allow read: if isCoupleMember(coupleId) && (
          resource.data.creatorUid == request.auth.uid ||
          request.time.toMillis() >= resource.data.scheduledRevealServerMillis
        );
        allow update, delete: if isCoupleMember(coupleId)
          && resource.data.creatorUid == request.auth.uid;
      }
    }
  }
}
